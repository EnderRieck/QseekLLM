+# ---------------------------------------------------------------------------
+# Optional phase-event logging for cross-trainer efficiency comparison.
+#
+# Every ``marked_timer(...)`` span (gen / ref / reward / update_actor /
+# update_weights / step / ...) can emit a ``{name}_start`` / ``{name}_end``
+# record with an absolute wall-clock timestamp, so a fine-grained Gantt of the
+# training pipeline can be reconstructed post-hoc and aligned against the
+# gpu.csv hardware-utilisation samples.
+#
+# This is OFF by default and has zero cost (one ``is None`` check per span)
+# unless a process *explicitly* calls ``enable_phase_events(path)``. Only the
+# orchestration/driver process should enable it; rollout/ref/reward worker
+# processes never call enable, so they neither emit nor touch the log file.
+# Writing must never interrupt training, so every write is defensive.
+# ---------------------------------------------------------------------------
+import json as _json
+import os as _os
+import time as _time
+
+_PHASE_EVENT_LOGGER = None
+
+
+class _PhaseEventLogger:
+    def __init__(self, path: str):
+        self.path = path
+        self.start_ts = _time.time()
+        self._fh = None
+        try:
+            d = _os.path.dirname(path)
+            if d:
+                _os.makedirs(d, exist_ok=True)
+            self._fh = open(path, "a", buffering=1)  # line-buffered
+            self.emit("phase_logger_start", pid=_os.getpid())
+        except Exception as exc:  # pragma: no cover - logging must never crash training
+            print(f"[PhaseEventLogger] disabled, failed to open {path}: {exc}")
+            self._fh = None
+
+    def emit(self, ev: str, **fields):
+        if self._fh is None:
+            return
+        try:
+            now = _time.time()
+            rec = {"ts": round(now, 6), "t": round(now - self.start_ts, 6), "ev": ev}
+            for k, v in fields.items():
+                if isinstance(v, float):
+                    v = round(v, 6)
+                rec[k] = v
+            self._fh.write(_json.dumps(rec, ensure_ascii=False) + "\n")
+        except Exception:  # pragma: no cover - never crash training on a log write
+            pass
+
+
+def enable_phase_events(path: str | None) -> bool:
+    """Enable marked_timer phase-event logging in *this* process.
+
+    Returns True if enabled. Call once from the trainer driver. No-op if
+    ``path`` is falsy or already enabled.
+    """
+    global _PHASE_EVENT_LOGGER
+    if not path or _PHASE_EVENT_LOGGER is not None:
+        return _PHASE_EVENT_LOGGER is not None
+    _PHASE_EVENT_LOGGER = _PhaseEventLogger(path)
+    print(f"[PhaseEventLogger] phase events -> {path}")
+    return True
+
+
+def _emit_phase(ev: str, name: str, **fields):
+    logger = _PHASE_EVENT_LOGGER
+    if logger is None:
+        return
+    logger.emit(ev, phase=name, **fields)
+
+
