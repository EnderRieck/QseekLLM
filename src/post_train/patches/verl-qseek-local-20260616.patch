+    async def pause_for_eval(self, drain_timeout_s: float = 180.0):
+        """Pause training-rollout generation so the vLLM engines are free for validation.
+
+        Reuses the same ``paused`` / ``_resume_event`` machinery as weight-sync: the
+        processor worker drains in-flight tasks and blocks on the resume event. We then
+        wait (bounded by ``drain_timeout_s``) for in-flight tasks to drain so held-out
+        eval does not contend with training sampling. Never blocks forever.
+        """
+        async with self.lock:
+            self.paused = True
+            self._resume_event.clear()
+        deadline = time.time() + drain_timeout_s
+        while time.time() < deadline:
+            async with self.lock:
+                remaining = len(self.active_tasks)
+            if remaining == 0:
+                break
+            await asyncio.sleep(0.5)
+        async with self.lock:
+            remaining = len(self.active_tasks)
+        print(
+            "[FullyAsyncRollouter][Eval] paused sampling for validation, "
+            f"in-flight tasks remaining={remaining}"
+        )
+        return {"fully_async/eval/drain_remaining": float(remaining)}
+
+    async def resume_after_eval(self):
+        """Resume training-rollout generation after validation finishes."""
+        async with self.lock:
+            self.paused = False
+            self._resume_event.set()
+        print("[FullyAsyncRollouter][Eval] resumed sampling after validation")
+        return {}
