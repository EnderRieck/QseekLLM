# LLMTrain Environment Variables
# Copy this file to .env and update with your local paths

# Data directory (where manifests and shards are stored)
DATA_DIR=/path/to/your/data

# Example paths that will be used:
# - ${DATA_DIR}/train_340b/manifest.jsonl
# - ${DATA_DIR}/val_60m/manifest.jsonl
# - ${DATA_DIR}/shards/...

# Optional: HuggingFace cache directory
# HF_HOME=${DATA_DIR}/hf_cache

# Optional: Tokenizer path
# TOKENIZER_PATH=${DATA_DIR}/tokenizer

# Optional: multi-node torchrun defaults
# LLMTRAIN_NNODES=2
# LLMTRAIN_NPROC_PER_NODE=8
# LLMTRAIN_MASTER_ADDR=10.201.132.7
# LLMTRAIN_MASTER_PORT=29500
# Do not set LLMTRAIN_NODE_RANK in a shared .env; pass --node-rank 0/1 per node.

# Optional: MetaX/MACA MCCL/NCCL settings
# MACA_PATH=/opt/maca
# LD_LIBRARY_PATH=/opt/maca/lib:/opt/maca/ompi/lib:/opt/maca/ucx/lib:/opt/mxdriver/lib
# MCCL_EXT_CCL_ENABLE=1
# MCCL_HC_PLUGIN=/opt/maca/lib/libmxccl_21605plugin.so
# NCCL_FORCE_USE_MN_MIX=1
# FORCE_ACTIVE_WAIT=1
# NCCL_IB_DISABLE=0
# NCCL_IB_HCA=mlx5_0,mlx5_1
# NCCL_SOCKET_IFNAME=eth0
# NCCL_CROSS_NIC=1
# NCCL_NET_GDR_LEVEL=0
# NCCL_NET_GDR_READ=0
# NCCL_P2P_LEVEL=SYS
# NCCL_ALGO=Ring
# NCCL_PROTO=Simple
# NCCL_BUFFSIZE=8388608
# NCCL_LIMIT_RING_LL_THREADTHRESHOLDS=1
#
# MCCL_IB_HCA=mlx5_0,mlx5_1
# MCCL_CROSS_NIC=1
# MCCL_NET_GDR_LEVEL=0
# MCCL_NET_GDR_READ=0
# MCCL_P2P_LEVEL=SYS
# MCCL_ALGO=Ring
# MCCL_PROTO=Simple
# MCCL_BUFFSIZE=8388608
# MCCL_REDUCE_SCATTER_SEND_RECV=1
# MCCL_ALL_GATHER_SEND_RECV=1
# MCCL_ALL_REDUCE_SEND_RECV=1
# MCCL_GDRCOPY_ENABLE=0
# MCCL_GDRCOPY_FIFO_ENABLE=0
# NCCL_DEBUG=WARN
# MCCL_DEBUG=WARN
