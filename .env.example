# LLMTrain Environment Variables
# Copy this file to .env and update with your local paths

# Data directory (where manifests and shards are stored)
DATA_DIR=/path/to/your/data

# Example paths that will be used:
# - ${DATA_DIR}/train_340b/manifest.jsonl
# - ${DATA_DIR}/val_60m/manifest.jsonl
# - ${DATA_DIR}/shards/...

# Optional: HuggingFace cache directory
# HF_HOME=${DATA_DIR}/hf_cache

# Optional: Tokenizer path
# TOKENIZER_PATH=${DATA_DIR}/tokenizer
